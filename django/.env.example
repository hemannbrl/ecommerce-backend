# Reference values — settings.py reads these from the environment (not a .env file), so
# export them before `python manage.py runserver` (e.g. `set -a; source .env.example; set +a`).
# The defaults in settings.py already match these, so a plain run works too. Do not commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=*

DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

JWT_SECRET=change-me-too
JWT_EXPIRY_MINUTES=1440
