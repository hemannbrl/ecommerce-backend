# Reference values for a local (non-Docker) run — export these before `./mvnw spring-boot:run`,
# or just rely on the defaults baked into application.yml. Docker compose sets its own env, so it
# does not read this file. Do not commit .env.
DB_URL=jdbc:postgresql://localhost:5433/ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRY_MINUTES=1440
PORT=8080
